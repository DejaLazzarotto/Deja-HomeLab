#!/usr/bin/env bash

set -e

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

source "$BASE_DIR/config/deja-platform.conf"
source "$BASE_DIR/lib/common.sh"
source "$BASE_DIR/commands/version.sh"

case "${1:-}" in
    version|--version|-v)
        platform_version
        ;;
    *)
        echo "Deja Platform CLI"
        echo ""
        echo "Uso:"
        echo "  platform version"
        exit 1
        ;;
esac