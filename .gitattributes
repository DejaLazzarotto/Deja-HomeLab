# Normalizacao de quebras de linha - Deja Platform
# Arquivos de texto: LF no Git e no diretorio de trabalho
* text=auto eol=lf

# Scripts Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Arquivos binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.mp3 binary
*.mp4 binary
*.mov binary
*.mpg binary
*.onnx binary
*.zip binary
*.gz binary
*.tar binary
*.woff binary
*.woff2 binary
